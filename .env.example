# ==============================================================================
# META GRAPH API CONFIGURATION (Facebook & Instagram)
# ==============================================================================
# Instructions:
# 1. Copy this file to .env (do NOT commit .env to git):
#    cp .env.example .env
# 2. Fill in your credentials below.
#
# Where to find these values:
# - META_ACCESS_TOKEN: Meta Graph API Explorer or System User token with:
#   'pages_manage_posts', 'pages_read_engagement', 'instagram_basic', 'instagram_content_publish'
# - META_PAGE_ID: Your Facebook Page ID (Settings > Page Setup > Page ID)
# - INSTAGRAM_ACCOUNT_ID: The Instagram Business Account ID connected to your Page.
#   (Found via GET https://graph.facebook.com/v21.0/{PAGE_ID}?fields=instagram_business_account)
# ==============================================================================

META_ACCESS_TOKEN=EAAG...your_long_lived_token_here...
META_PAGE_ID=123456789012345
INSTAGRAM_ACCOUNT_ID=987654321098765
META_GRAPH_VERSION=v21.0
